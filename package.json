{
  "name": "clinic-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone clinic workspace for findmydoc clinic teams.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "^10"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm governance:check && pnpm ai:slop-check && pnpm deadcode:check",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project chromium",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:storybook && pnpm test:e2e:smoke",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --port 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:slop-check": "node scripts/ai-slop-policy-check.mjs",
    "ai:slop-check:prepush": "node scripts/ai-slop-pre-push-check.mjs",
    "architecture:check": "node scripts/architecture-policy-check.mjs",
    "stories:governance:check": "node scripts/storybook-governance-check.mjs",
    "governance:check": "pnpm architecture:check && pnpm stories:governance:check",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "deadcode:check": "knip --include files,exports",
    "deps:audit": "audit-ci --config audit-ci.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.22.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/nextjs-vite": "10.4.6",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "audit-ci": "7.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-storybook": "10.4.6",
    "jsdom": "29.1.1",
    "knip": "6.23.0",
    "playwright": "1.61.1",
    "postcss": "8.5.23",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shadcn": "4.12.0",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "next@16.2.12>postcss": "8.5.23",
      "next@16.2.12>sharp": "0.35.0"
    }
  }
}
